<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="Robotic_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
        <xacro:arg name="use_gazebo" default="true"/>
        <ros2_control name="${name}" type="system">
            <hardware>
                  <xacro:if value="$(arg use_gazebo)">
                    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
                  </xacro:if>
                  <xacro:unless value="$(arg use_gazebo)">
                    <plugin>mock_components/GenericSystem</plugin>
                  </xacro:unless>
            </hardware>
            <joint name="revolute_7">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['revolute_7']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="revolute_8">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['revolute_8']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="revolute_1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['revolute_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="revolute_2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['revolute_2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="revolute_3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['revolute_3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="revolute_4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['revolute_4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="revolute_5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['revolute_5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="revolute_6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['revolute_6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
        
    </xacro:macro>
</robot>
